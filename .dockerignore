# В контекст сборки включаем только файлы приложения, миграций и тестов.
**
!Dockerfile
!.dockerignore
!requirements.lock
!alembic.ini
!pyproject.toml
!app/
!app/**
!migrations/
!migrations/**
!tests/
!tests/**
**/__pycache__/
**/*.py[cod]
**/.env
**/.env.*
**/*.pem
**/*.key
**/.pytest_cache/
**/.ruff_cache/
**/.envrc
**/.idea/
**/.vscode/
**/.aws/
**/.ssh/
**/*.p12
**/*.pfx
**/id_rsa
**/id_ed25519
**/logs/
**/dumps/
**/*.log
**/*.dump
**/*.sql.gz
**/*.tmp
**/*.bak
**/*~
**/.DS_Store
