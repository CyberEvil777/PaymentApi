# Значения для разработки; замените API_KEY перед открытием доступа к API.
API_KEY=local-test-api-key-change-me
# URL для запуска Python на хосте; Compose задаёт адреса postgres/rabbitmq самостоятельно.
DATABASE_URL=postgresql+asyncpg://payments:payments@localhost:5432/payments
RABBITMQ_URL=amqp://payments:payments@localhost:5672/
OUTBOX_POLL_SECONDS=0.5
# Общий срок доставки webhook и сетевые HTTP-таймауты в секундах.
WEBHOOK_TIMEOUT_SECONDS=10

# Порты на хосте; внутри Docker-сети используются стандартные порты сервисов.
# Значение 0 назначает свободный порт, например для изолированной проверки.
API_PORT=8000
POSTGRES_PORT=5432
AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
# Для нового окружения. При существующем volume сохраните прежний hostname (см. README).
RABBITMQ_HOSTNAME=rabbitmq
